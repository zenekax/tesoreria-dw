<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT c.alias AS cuenta, k.estado, k.origen,&#xa;       COALESCE(k.pago_id, k.cobranza_id, k.linea_extracto_id) AS partida,&#xa;       COALESCE(fl.fecha, fb.fecha) AS fecha,&#xa;       COALESCE(k.monto_libro, k.monto_banco) AS monto,&#xa;       DATEDIFF(DAY, COALESCE(fl.fecha, fb.fecha), &apos;2026-10-31&apos;) AS dias_abierta,&#xa;       mv.descripcion AS descripcion_banco&#xa;FROM dw.fact_conciliacion k&#xa;JOIN dw.dim_banco_cuenta c ON c.banco_cuenta_key = k.banco_cuenta_key&#xa;LEFT JOIN dw.dim_fecha fl ON fl.fecha_key = k.fecha_libro_key AND fl.fecha_key &gt; 0&#xa;LEFT JOIN dw.dim_fecha fb ON fb.fecha_key = k.fecha_banco_key AND fb.fecha_key &gt; 0&#xa;LEFT JOIN dw.fact_movimientos_bancarios mv ON mv.linea_extracto_id = k.linea_extracto_id&#xa;WHERE k.estado IN (&apos;PENDIENTE_EN_BANCO&apos;, &apos;PENDIENTE_EN_LIBROS&apos;)&#xa;ORDER BY dias_abierta DESC, cuenta" StatementId="1" StatementCompId="2" StatementType="SELECT" StatementSqlHandle="0x0900DF841AD4B3CC045BEDCD66B89B720C820000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="5.18073" StatementEstRows="186.364" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x217518866209983A" QueryPlanHash="0x908CC2A0BBFF0D29" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="10" MemoryGrant="42008" CachedPlanSize="136" CompileTime="18" CompileCPU="18" CompileMemory="1432"><ThreadStat Branches="4" UsedThreads="30"><ThreadReservation NodeId="0" ReservedThreads="20"></ThreadReservation><ThreadReservation NodeId="1" ReservedThreads="20"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="61.4624"><MissingIndex Database="[TesoreriaDW_perf]" Schema="[dw]" Table="[fact_conciliacion]"><ColumnGroup Usage="INEQUALITY"><Column Name="[estado]" ColumnId="19"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[origen]" ColumnId="2"></Column><Column Name="[pago_id]" ColumnId="3"></Column><Column Name="[cobranza_id]" ColumnId="4"></Column><Column Name="[linea_extracto_id]" ColumnId="5"></Column><Column Name="[banco_cuenta_key]" ColumnId="8"></Column><Column Name="[fecha_libro_key]" ColumnId="12"></Column><Column Name="[fecha_banco_key]" ColumnId="13"></Column><Column Name="[monto_libro]" ColumnId="15"></Column><Column Name="[monto_banco]" ColumnId="16"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="1664" SerialDesiredMemory="2592" RequiredMemory="41048" DesiredMemory="42008" RequestedMemory="42008" GrantWaitTime="0" MaxQueryMemory="145720" GrantedMemory="42008" MaxUsedMemory="11824" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="20971" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="5" MaxCompileMemory="293208"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-19T20:14:25.90" ModificationCount="0" SamplingPercent="27.9067" Statistics="[_WA_Sys_00000008_2DE6D218]" Table="[fact_conciliacion]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:57.49" ModificationCount="0" SamplingPercent="100" Statistics="[pk_dim_banco_cuenta]" Table="[dim_banco_cuenta]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:05.64" ModificationCount="0" SamplingPercent="38.2925" Statist