<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH apertura AS (&#xa;    SELECT s.moneda_key, SUM(s.saldo_inicial) AS saldo_inicial&#xa;    FROM dw.fact_saldo_bancario_mensual s&#xa;    WHERE s.fecha_cierre_key = (SELECT MIN(fecha_cierre_key) FROM dw.fact_saldo_bancario_mensual)&#xa;    GROUP BY s.moneda_key&#xa;), movimientos AS (&#xa;    SELECT m.moneda_key, m.fecha_imputacion_key AS fecha_key,&#xa;           SUM(IIF(m.monto &gt; 0, m.monto, 0)) AS ingresos, SUM(IIF(m.monto &lt; 0, m.monto, 0)) AS egresos&#xa;    FROM dw.fact_movimientos_bancarios m&#xa;    GROUP BY m.moneda_key, m.fecha_imputacion_key&#xa;)&#xa;SELECT d.fecha, mo.codigo_iso AS moneda, ISNULL(mv.ingresos, 0) AS ingresos, ISNULL(mv.egresos, 0) AS egresos,&#xa;       a.saldo_inicial + SUM(ISNULL(mv.ingresos, 0) + ISNULL(mv.egresos, 0))&#xa;           OVER (PARTITION BY mo.codigo_iso ORDER BY d.fecha ROWS UNBOUNDED PRECEDING) AS saldo_cierre&#xa;FROM dw.dim_fecha d&#xa;CROSS JOIN apertura a&#xa;JOIN dw.dim_moneda mo ON mo.moneda_key = a.moneda_key&#xa;LEFT JOIN movimientos mv ON mv.moneda_key = a.moneda_key AND mv.fecha_key = d.fecha_key&#xa;WHERE d.fecha BETWEEN &apos;2025-11-01&apos; AND &apos;2026-10-31&apos;&#xa;ORDER BY moneda, d.fecha" StatementId="1" StatementCompId="2" StatementType="SELECT" StatementSqlHandle="0x0900EC2EC85F0EB441828FE7872DB95C6F4F0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="0.0783863" StatementEstRows="1262.35" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x8162F490C2CFA613" QueryPlanHash="0x89CC79E565DADF05" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="10456" CachedPlanSize="216" CompileTime="16" CompileCPU="16" CompileMemory="2024"><MemoryGrantInfo SerialRequiredMemory="9376" SerialDesiredMemory="10456" RequiredMemory="9376" DesiredMemory="10456" RequestedMemory="10456" GrantWaitTime="0" MaxQueryMemory="146024" GrantedMemory="10456" MaxUsedMemory="3576" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="20971" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="5" MaxCompileMemory="264360"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-19T20:09:25.79" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000002_1EA48E88]" Table="[fact_saldo_bancario_mensual]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:05.64" ModificationCount="0" SamplingPercent="38.2925" Statistics="[uq_fact_movimientos_linea]" Table="[fact_movimientos_bancarios]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:25.79" ModificationCount="0" SamplingPercent="100" Statistics="[pk_fact_saldo_bancario_mensual]" Table="[fact_saldo_bancario_mensual]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:05.86" ModificationCount="0" SamplingPercent="39.4193" Statistics="[pk_fact_movimientos_bancarios]" Table="[fact_movimientos_bancarios]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:05:57.22" ModificationCount="5" SamplingPercent="100" Statistics="[pk_dim_moneda]" Table="[dim_moneda]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:05.97" ModificationCount="0" SamplingPercent="38.2925" Statistics="[_WA_Sys_00000004_1332DBDC]" Table="[fact_movimientos_bancarios]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:21:50.94" ModificationCount="0" SamplingPercent="100" Statistics="[ux_dim_fecha_fecha]" Table="[dim_fecha]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:14:25.42" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000003_1EA48E88]" Table="[fact_saldo_bancario_mensual]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:05:57.21" ModificationCount="2" SamplingPercent="100" Statistics="[pk_dim_fecha]" Table="[dim_fecha]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:05.92" ModificationCount="0" SamplingPercent="38.2925" Statistics="[_WA_Sys_00000006_1332DBDC]" Table="[fact_movimientos_bancarios]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo></OptimizerStatsUsage><QueryTimeStats ElapsedTime="13" CpuTime="13"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1262.35" EstimateIO="0" EstimateCPU="1.26235e-05" AvgRowSize="64" EstimatedTotalSubtreeCost="0.0783863" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Batch"><OutputList><ColumnReference Database="[TesoreriaDW_perf]" Schema="[dw]" Table="[dim_fecha]" Alias="[d]" Column="fecha"></ColumnReference><ColumnReference Database="[TesoreriaDW_perf]" Schema="[dw]" Table="[dim_moneda]" Alias="[mo]" Column="codigo_iso"></ColumnReference><ColumnReference Column="Expr1017"></ColumnReference><ColumnReference Column="Expr1018"></ColumnReference><ColumnReference Column="Expr1019"></ColumnReference></OutputList><RunTimeInformation><RunTimeCountersPerThread Thread="0" ActualRows="1825" Batches="3"