# Copiar a .env y completar:  cp .env.example .env
# NUNCA commitear .env (está en .gitignore).
# La contraseña de SQL Server requiere: 8+ caracteres, mayúscula, minúscula, número y símbolo.
MSSQL_SA_PASSWORD=CambiarEstaClave_123!
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=TesoreriaDW
# Driver ODBC instalado en el Mac (ver README):
MSSQL_ODBC_DRIVER="ODBC Driver 18 for SQL Server"
# Usuario de aplicación para la carga (scripts/run_sql.sh lo crea con permisos mínimos):
MSSQL_ETL_USER=tdw_etl
MSSQL_ETL_PASSWORD=CambiarEstaClaveEtl_123!
# Login de solo lectura para Power BI (Fase 8/9): rol_lectura_analistas, ve todas las monedas, datos sensibles enmascarados.
MSSQL_BI_USER=tdw_powerbi
MSSQL_BI_PASSWORD=CambiarEstaClaveBi_123!
