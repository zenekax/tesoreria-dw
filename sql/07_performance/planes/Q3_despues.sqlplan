<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT c.alias AS cuenta, k.estado, k.origen,&#xa;       COALESCE(k.pago_id, k.cobranza_id, k.linea_extracto_id) AS partida,&#xa;       COALESCE(fl.fecha, fb.fecha) AS fecha,&#xa;       COALESCE(k.monto_libro, k.monto_banco) AS monto,&#xa;       DATEDIFF(DAY, COALESCE(fl.fecha, fb.fecha), &apos;2026-10-31&apos;) AS dias_abierta,&#xa;       mv.descripcion AS descripcion_banco&#xa;FROM dw.fact_conciliacion k&#xa;JOIN dw.dim_banco_cuenta c ON c.banco_cuenta_key = k.banco_cuenta_key&#xa;LEFT JOIN dw.dim_fecha fl ON fl.fecha_key = k.fecha_libro_key AND fl.fecha_key &gt; 0&#xa;LEFT JOIN dw.dim_fecha fb ON fb.fecha_key = k.fecha_banco_key AND fb.fecha_key &gt; 0&#xa;LEFT JOIN dw.fact_movimientos_bancarios mv ON mv.linea_extracto_id = k.linea_extracto_id&#xa;WHERE k.estado IN (&apos;PENDIENTE_EN_BANCO&apos;, &apos;PENDIENTE_EN_LIBROS&apos;)&#xa;ORDER BY dias_abierta DESC, cuenta" StatementId="1" StatementCompId="2" StatementType="SELECT" StatementSqlHandle="0x0900DF841AD4B3CC045BEDCD66B89B720C820000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="1.56434" StatementEstRows="245.594" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x217518866209983A" QueryPlanHash="0x72234B992F6FB8BD" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160" BatchModeOnRowStoreUsed="true"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="5888" CachedPlanSize="224" CompileTime="14" CompileCPU="14" CompileMemory="1624"><MemoryGrantInfo SerialRequiredMemory