<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH cierres AS (&#xa;    SELECT EOMONTH(CAST(&apos;2025-11-01&apos; AS DATE)) AS cierre, 1 AS nro&#xa;    UNION ALL&#xa;    SELECT EOMONTH(DATEADD(MONTH, 1, cierre)), nro + 1 FROM cierres WHERE cierre &lt; &apos;2026-10-31&apos;&#xa;), cierres_key AS (&#xa;    SELECT cierre, nro, CONVERT(INT, CONVERT(CHAR(8), cierre, 112)) AS cierre_key FROM cierres&#xa;), cobrado_mes AS (    -- 1. cobrado por factura y mes&#xa;    SELECT x.factura_id, EOMONTH(fc.fecha) AS cierre, SUM(x.monto) AS cobrado_mes&#xa;    FROM dw.fact_cobranzas x&#xa;    JOIN dw.dim_fecha fc ON fc.fecha_key = x.fecha_cobranza_key&#xa;    GROUP BY x.factura_id, EOMONTH(fc.fecha)&#xa;), grilla AS (         -- 2. cada factura AR en cada cierre desde su emisión&#xa;    SELECT c.cierre, f.factura_id, f.monto, f.monto_usd, f.fecha_vencimiento_key&#xa;    FROM cierres_key c&#xa;    JOIN dw.fact_facturas f ON f.tipo_factura = &apos;AR&apos; AND f.fecha_emision_key &lt;= c.cierre_key&#xa;), acumulado AS (      -- 3. lo cobrado hasta cada cierre = suma acumulada de los meses&#xa;    SELECT g.*, SUM(ISNULL(cm.cobrado_mes, 0)) OVER (PARTITION BY g.factura_id ORDER BY g.cierre&#xa;                                                     ROWS UNBOUNDED PRECEDING) AS cobrado&#xa;    FROM grilla g&#xa;    LEFT JOIN cobrado_mes cm ON cm.factura_id = g.factura_id AND cm.cierre = g.cierre&#xa;), saldos AS (&#xa;    SELECT a.cierre, a.monto_usd * (a.monto - a.cobrado) / a.monto AS saldo_usd,&#xa;           DATEDIFF(DAY, fv.fecha, a.cierre) AS dias_vencido&#xa;    FROM acumulado a&#xa;    JOIN dw.dim_fecha fv ON fv.fecha_key = a.fecha_vencimiento_key&#xa;    WHERE a.monto - a.cobrado &gt; 0&#xa;)&#xa;SELECT cierre, COUNT(*) AS facturas_abiertas, CAST(SUM(saldo_usd) AS DECIMAL(19,2)) AS cartera_usd,&#xa;       CAST(SUM(IIF(dias_vencido &gt; 30, saldo_usd, 0)) AS DECIMAL(19,2)) AS vencida_30_usd&#xa;FROM saldos&#xa;GROUP BY cierre&#xa;ORDER BY cierre&#xa;-- MAXDOP 1: medido a escala 20, el plan en paralelo terminaba casi igual de rápido (0,69 s vs 0,71 s)&#xa;-- pero usaba 5 veces más CPU (ordenar la window function en varios hilos). En un servidor con&#xa;-- varios usuarios, esa CPU se la saca a otras consultas: no vale la pena.&#xa;OPTION (MAXRECURSION 36, MAXDOP 1)" StatementId="1" StatementCompId="2" StatementType="SELECT" StatementSqlHandle="0x09007F3026B2D864F2CF8E2FDF3112BAEE8A0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="11.4766" StatementEstRows="1.09545" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x9870E2C68AE98651" QueryPlanHash="0xE03B32C428B2B667" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="114768" NonParallelPlanReason="MaxDOPSetToOne" CachedPlanSize="184" CompileTime="17" CompileCPU="17" CompileMemory="2744"><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT(char(8),[Recr1006],112)"></PlanAffectingConvert></Warnings><MemoryGrantInfo SerialRequiredMemory="2688" SerialDesiredMemory="114768" RequiredMemory="2688" DesiredMemory="114768" RequestedMemory="114768" GrantWaitTime="0" MaxQueryMemory="145712" GrantedMemory="114768" MaxUsedMemory="41256" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="Yes: Percentile Adjusting"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="20971" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="1" MaxCompileMemory="284920"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-19T20:21:51.49" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000004_08B54D69]" Table="[fact_cobranzas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:14:16.13" ModificationCount="0" SamplingPercent="42.7591" Statistics="[_WA_Sys_00000004_71D1E811]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:55.38" ModificationCount="0" SamplingPercent="44.282" Statistics="[pk_fact_facturas]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:49.40" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000002_534D60F1]" Table="[dim_fecha]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:23:13.68" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000008_08B54D69]" Table="[fact_cobranzas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:55.29" ModificationCount="0" SamplingPercent="42.7591" Statistics="[_WA_Sys_00000008_71D1E811]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:55.12" ModificationCount="0" SamplingPercent="42.7591" Statistics="[uq_fact_facturas_id]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:26:54.85" ModificationCount="0" SamplingPercent="100" Statistics="[ix_fact_cobranzas_factura]" Table="[fact_cobranzas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:00.66" ModificationCount="0" SamplingPercent="100" Statistics="[uq_fact_cobranzas_id]" Table="[fact_cobranzas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:26:54.95" ModificationCount="0" SamplingPercent="100" Statistics="[fx_fact_facturas_ar_emision]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:05:57.21" ModificationCount="2" SamplingPercent="100" Statistics="[pk_dim_fecha]" Table="[dim_fecha]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="RESERVED_MEMORY_ALLOCATION_EXT" WaitTimeMs="2" WaitCount="5247"></Wait></WaitStats><QueryTimeStats ElapsedTime="1238" CpuTime="1238"></QueryTimeStats><RelOp NodeId="0" PhysicalOp="Sort" LogicalOp="Sort" EstimateRows="1.09545" EstimateIO="0.0112613" EstimateCPU="0.000100257" AvgRowSize="32" EstimatedTotalSubtreeCost="11.4766" Parallel="0" EstimateRebinds="0" EstimateRewinds="0" EstimatedExecutionMode="Row"><OutputList><ColumnReference Column="Recr1006"></ColumnReference><ColumnReference Column="Expr1022"></ColumnReference><ColumnReference Column="Expr1025"></ColumnReference><ColumnReference Column="Expr1026"></ColumnReference></OutputList><MemoryFractions Input="0.655685" Output="1"></MemoryFractions><RunTimeInformation><RunTimeCountersPerThread Thread="0" ActualRows="12" Batches="0" ActualElapsedms="1237" ActualCPUms="1237" ActualScans="0" ActualLogicalReads="0" ActualPhysicalReads="0" ActualReadAheads="0" ActualLobLogicalReads="0" ActualLobPhysicalReads="0" ActualLobReadAheads="0" ActualRebinds="1" ActualRewinds="0" ActualEndOfScans="1" ActualExecutions="1" InputMemoryGrant="74000" OutputMemoryGrant="112208" UsedMemoryGrant="16" ActualExecutionMode="Row"></RunTimeCountersPerThread></RunTimeInformation><Sort Distinct="0"><OrderBy><OrderByColumn Ascending="1"><ColumnReference Column="Recr1006"></ColumnReference></OrderByColumn></OrderBy><RelOp NodeId="1" PhysicalOp="Compute Scalar" LogicalOp="Compute Scalar" EstimateRows="1.09545" EstimateIO="0" EstimateCPU="1.09545e-07" AvgRowSize="32" EstimatedTotalS