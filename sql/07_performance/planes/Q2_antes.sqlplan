<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.4325.4"><BatchSequence><Batch><Statements><StmtSimple StatementText="WITH cierres AS (&#xa;    SELECT EOMONTH(CAST(&apos;2025-11-01&apos; AS DATE)) AS cierre, 1 AS nro&#xa;    UNION ALL&#xa;    SELECT EOMONTH(DATEADD(MONTH, 1, cierre)), nro + 1 FROM cierres WHERE cierre &lt; &apos;2026-10-31&apos;&#xa;), cierres_key AS (&#xa;    SELECT cierre, nro, CONVERT(INT, CONVERT(CHAR(8), cierre, 112)) AS cierre_key FROM cierres&#xa;)&#xa;SELECT c.cierre, cartera.facturas_abiertas, CAST(cartera.cartera_usd AS DECIMAL(19,2)) AS cartera_usd,&#xa;       CAST(cartera.vencida_30_usd AS DECIMAL(19,2)) AS vencida_30_usd&#xa;FROM cierres_key c&#xa;CROSS APPLY (&#xa;    SELECT COUNT(*) AS facturas_abiertas, ISNULL(SUM(a.saldo_usd), 0) AS cartera_usd,&#xa;           ISNULL(SUM(IIF(a.dias_vencido &gt; 30, a.saldo_usd, 0)), 0) AS vencida_30_usd&#xa;    FROM (&#xa;        SELECT f.monto_usd * (f.monto - ISNULL(cb.cobrado, 0)) / f.monto AS saldo_usd,&#xa;               DATEDIFF(DAY, fv.fecha, c.cierre) AS dias_vencido&#xa;        FROM dw.fact_facturas f&#xa;        JOIN dw.dim_fecha fv ON fv.fecha_key = f.fecha_vencimiento_key&#xa;        OUTER APPLY (SELECT SUM(x.monto) AS cobrado FROM dw.fact_cobranzas x&#xa;                     WHERE x.factura_id = f.factura_id AND x.fecha_cobranza_key &lt;= c.cierre_key) cb&#xa;        WHERE f.tipo_factura = &apos;AR&apos; AND f.fecha_emision_key &lt;= c.cierre_key&#xa;          AND f.monto - ISNULL(cb.cobrado, 0) &gt; 0&#xa;    ) a&#xa;) cartera&#xa;ORDER BY c.cierre&#xa;OPTION (MAXRECURSION 36)" StatementId="1" StatementCompId="2" StatementType="SELECT" StatementSqlHandle="0x090077EABF8CEC64E229BCFA2045E01AE16E0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="1" ParentObjectId="0" StatementParameterizationType="0" RetrievedFromCache="true" StatementSubTreeCost="27.1476" StatementEstRows="4" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x75253C0D3BDB7951" QueryPlanHash="0x5610EA075FCFD5BE" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="2056" CachedPlanSize="120" CompileTime="19" CompileCPU="19" CompileMemory="1304"><MissingIndexes><MissingIndexGroup Impact="6.52957"><MissingIndex Database="[TesoreriaDW_perf]" Schema="[dw]" Table="[fact_facturas]"><ColumnGroup Usage="EQUALITY"><Column Name="[tipo_factura]" ColumnId="4"></Column></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[fecha_emision_key]" ColumnId="7"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[factura_id]" ColumnId="2"></Column><Column Name="[fecha_vencimiento_key]" ColumnId="8"></Column><Column Name="[monto]" ColumnId="9"></Column><Column Name="[monto_usd]" ColumnId="11"></Column></ColumnGroup></MissingIndex></MissingIndexGroup><MissingIndexGroup Impact="12.8885"><MissingIndex Database="[TesoreriaDW_perf]" Schema="[dw]" Table="[fact_facturas]"><ColumnGroup Usage="EQUALITY"><Column Name="[tipo_factura]" ColumnId="4"></Column><Column Name="[fecha_vencimiento_key]" ColumnId="8"></Column></ColumnGroup><ColumnGroup Usage="INEQUALITY"><Column Name="[fecha_emision_key]" ColumnId="7"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[factura_id]" ColumnId="2"></Column><Column Name="[monto]" ColumnId="9"></Column><Column Name="[monto_usd]" ColumnId="11"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><Warnings><PlanAffectingConvert ConvertIssue="Cardinality Estimate" Expression="CONVERT(char(8),[Recr1006],112)"></PlanAffectingConvert></Warnings><MemoryGrantInfo SerialRequiredMemory="1536" SerialDesiredMemory="2056" RequiredMemory="1536" DesiredMemory="2056" RequestedMemory="2056" GrantWaitTime="0" MaxQueryMemory="145688" GrantedMemory="2056" MaxUsedMemory="720" LastRequestedMemory="0" IsMemoryGrantFeedbackAdjusted="No: First Execution"></MemoryGrantInfo><OptimizerHardwareDependentProperties EstimatedAvailableMemoryGrant="20971" EstimatedPagesCached="13107" EstimatedAvailableDegreeOfParallelism="5" MaxCompileMemory="293328"></OptimizerHardwareDependentProperties><OptimizerStatsUsage><StatisticsInfo LastUpdate="2026-11-19T20:21:51.49" ModificationCount="0" SamplingPercent="100" Statistics="[_WA_Sys_00000004_08B54D69]" Table="[fact_cobranzas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:14:16.13" ModificationCount="0" SamplingPercent="42.7591" Statistics="[_WA_Sys_00000004_71D1E811]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:55.38" ModificationCount="0" SamplingPercent="44.282" Statistics="[pk_fact_facturas]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:55.29" ModificationCount="0" SamplingPercent="42.7591" Statistics="[_WA_Sys_00000008_71D1E811]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:08:55.12" ModificationCount="0" SamplingPercent="42.7591" Statistics="[uq_fact_facturas_id]" Table="[fact_facturas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:09:00.66" ModificationCount="0" SamplingPercent="100" Statistics="[uq_fact_cobranzas_id]" Table="[fact_cobranzas]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo><StatisticsInfo LastUpdate="2026-11-19T20:05:57.21" ModificationCount="2" SamplingPercent="100" Statistics="[pk_dim_fecha]" Table="[dim_fecha]" Schema="[dw]" Database="[TesoreriaDW_perf]"></StatisticsInfo></OptimizerStatsUsage><WaitStats><Wait WaitType="MEMORY_ALLOCATION_E